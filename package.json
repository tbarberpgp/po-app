{
  "name": "po-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "preview": "vite build && wrangler dev",
    "predeploy": "node scripts/predeploy-guard.mjs",
    "deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply po_app_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply po_app_db --remote",
    "db:seed:local": "wrangler d1 execute po_app_db --local --file=./migrations/0002_seed.sql",
    "db:console:local": "wrangler d1 execute po_app_db --local --command",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "fast-xml-parser": "^5.9.3",
    "fflate": "^0.8.3",
    "hono": "^4.6.14",
    "leaflet": "^1.9.4",
    "mammoth": "^1.12.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "postal-mime": "^2.7.4",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "^1.1.0",
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wrangler": "^4.94.0"
  }
}
